<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone Android Layout for Swift Splash Screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Center Container holding Icon, App Name & Tagline -->
    <LinearLayout
        android:id="@+id/splashContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- App Icon / Vector Logo -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="Swift App Icon"
            android:src="@drawable/ic_swift_app_icon" />

        <!-- App Name: Swift -->
        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05"
            android:text="Swift"
            android:textColor="#1F2937"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Tagline: All-in-One PDF Utility -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.1"
            android:text="All-in-One PDF Utility"
            android:textColor="#6B7280"
            android:textSize="15sp" />

    </LinearLayout>

</RelativeLayout>
